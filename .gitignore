/target
/web/node_modules
.DS_Store

# The folder itself has to exist for rust-embed to compile; its contents are
# built artefacts.
/web/dist/*
!/web/dist/.gitkeep
web/tsconfig.tsbuildinfo

# Coverage reports are generated on demand and never read from the repo.
/web/coverage
/llvm-cov

# Exported reviews. They are made to be handed to somebody, not committed:
# the map already lives under the git dir, and a copy in the tree would go
# stale the moment the branch moves.
*.farol.json
